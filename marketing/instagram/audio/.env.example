# ============================================================================
# Configuración de ElevenLabs para generación de voces
# ============================================================================

# API Key de ElevenLabs
# Obtén tu key en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-api-key-here

# Voice ID para la voz épica de Zaturno (grave, espacial)
# Busca una voz masculina grave en español
ELEVENLABS_VOICE_ID=your-zaturno-voice-id

# Voice ID para la voz del perro (colombiana tranquila, amigable)
# Busca una voz masculina o neutral, acento colombiano o latino neutral
ELEVENLABS_VOICE_ID_PERRO=your-perro-voice-id

# ============================================================================
# Cómo usar:
# ============================================================================
# 1. Copia este archivo a .env.local
# 2. Reemplaza los valores con tus keys reales
# 3. Los scripts de generación de voz lo cargarán automáticamente
#
# PowerShell:
#   $env:ELEVENLABS_API_KEY="tu-api-key"
#   $env:ELEVENLABS_VOICE_ID_PERRO="voice-id"
#
# Bash:
#   export ELEVENLABS_API_KEY="tu-api-key"
#   export ELEVENLABS_VOICE_ID_PERRO="voice-id"
